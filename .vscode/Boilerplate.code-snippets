{
	"BOILERPLATE_Service": {
		"scope": "typescript,typescriptreact",
		"prefix": "boilerplate-service",
		"body": [
			"/*",
			"[=[",
			"    @class ${1:NAME}_Service",
			"    @author ${2:author}",
			"    @description ${3:Service boilerplate}",
			"",
			"    CHANGELOG: [",
			"        ${4:yy/mm/dd} --> Initial version.",
			"    ]",
			"]=]",
			"*/",
			"",
			"/*",
			"--------------------------------------------------------------------",
			"--- Dependencies",
			"--------------------------------------------------------------------",
			"*/",
			"// Roblox services",
			"",
			"// Packages",
			"import { Service, OnInit, OnStart } from \"@flamework/core\";",
			"import { t } from \"@rbxts/t\";",
			"",
			"// Types",
			"import * as Types from \"server/types/${1:NAME}_Service\";",
			"",
			"// Networking",
			"import ${1:NAME}_Network from \"shared/networking/${1:NAME}_Network\";",
			"",
			"// Local utilities",
			"",
			"// Services",
			"",
			"/*",
			"--------------------------------------------------------------------",
			"--- Module",
			"--------------------------------------------------------------------",
			"*/",
			"",
			"@Service()",
			"export default class ${1:NAME}_ServiceClass implements Types.default, OnInit, OnStart {",
			"\t/*",
			"\t\truntime fields",
			"\t*/",
			"",
			"\t/*",
			"\t--------------------------------------------------------------------",
			"\t--- Variables",
			"\t--------------------------------------------------------------------",
			"\t*/",
			"\tprivate _: undefined;",
			"",
			"\tprivate check = t.strictArray(t.string);",
			"",
			"\t/*",
			"\t--------------------------------------------------------------------",
			"\t--- Helpers",
			"\t--------------------------------------------------------------------",
			"\t*/",
			"\tprivate help() {",
			"\t\treturn \"helping\";",
			"\t}",
			"",
			"\t/*",
			"\t--------------------------------------------------------------------",
			"\t--- Constructor",
			"\t--------------------------------------------------------------------",
			"\t*/",
			"\t//constructor(private readonly network: ${1:NAME}_Network) {} // dependency injection",
			"\tconstructor() {}",
			"",
			"\t/*",
			"\t--------------------------------------------------------------------",
			"\t--- Init / Start",
			"\t--------------------------------------------------------------------",
			"\t*/",
			"\tpublic onInit() {",
			"\t\t/* initialization logic here */",
			"\t}",
			"",
			"\tpublic onStart() {",
			"\t\t/* start/runtime logic here */",
			"\t}",
			"",
			"\t/*",
			"\t--------------------------------------------------------------------",
			"\t--- Public API",
			"\t--------------------------------------------------------------------",
			"\t*/",
			"\tpublic doSomething() {",
			"\t\treturn new Promise<void>((resolve) => {",
			"\t\t\tassert(this.check(\"\"));",
			"\t\t\tprint(this.help());",
			"\t\t\treturn resolve();",
			"\t\t});",
			"\t}",
			"}"
		],
		"description": "Service boilerplate"
	},
	"BOILERPLATE_Declaration": {
		"scope": "typescript,typescriptreact",
		"prefix": "boilerplate-declaration",
		"body": [
			"/*",
			"--------------------------------------------------------------------",
			"--- Dependencies",
			"--------------------------------------------------------------------",
			"*/",
			"import Promise from \"@rbxts-js/roblox-lua-promise\";",
			"",
			"/*",
			"--------------------------------------------------------------------",
			"--- Types",
			"--------------------------------------------------------------------",
			"*/",
			"export type ${1:NAME}Type = \"a\" | \"b\";",
			"",
			"export default interface ${1:NAME}Members {",
			"\tdoSomething(this: ${1:NAME}Members, a: ${1:NAME}Type): Promise<void>;",
			"}"
		],
		"description": "Declarations file"
	},
	"BOILERPLATE_Network": {
		"scope": "typescript,typescriptreact",
		"prefix": "boilerplate-network",
		"body": [
			"/*",
			"[=[",
			"\t@class ${1:NAME}_Network",
			"\t@author ${2:author}",
			"\t@description ${3:Boilerplate for networking stuff}",
			"",
			"\tCHANGELOG: [",
			"\t\t${4:yy/mm/dd} --> change",
			"\t]",
			"]=]",
			"*/",
			"",
			"/*",
			"--------------------------------------------------------------------",
			"--- Dependencies",
			"--------------------------------------------------------------------",
			"*/",
			"import Net, { Definitions } from \"@rbxts/net\";",
			"",
			"export = Net.CreateDefinitions({",
			"\tTemplate: Definitions.ServerToClientEvent<[]>(),",
			"});"
		],
		"description": "Network definitions boilerplate"
	}
}
